document.addEventListener("DOMContentLoaded", ()=>{
    const cards = document.querySelectorAll(".card");
    const stack = Array.from(cards);
    const nextButton = document.getElementById("next");
    const backButton = document.getElementById("back");
    const cakeBaseColors = [
        '--vanilla-white',
        '--chocolate-brown',
        '--red-velvet',
        '--matcha-green',
        '--blueberry-purple'
    ];
    const icingColors = [
        '--cherry-red',
        '--caramel-drizzle',
        '--golden-sprinkles',
        '--dark-chocolate-shavings',
        '--berry-blue-frosting'
    ];
    document.querySelectorAll('.card').forEach((card)=>{
        const cakeLayers = card.querySelectorAll('.top-layer, .middle-layer, .bottom-layer');
        cakeLayers.forEach((layer)=>{
            const cakeColor = getComputedStyle(document.documentElement).getPropertyValue(cakeBaseColors[Math.floor(Math.random() * cakeBaseColors.length)]);
            const icingColor = getComputedStyle(document.documentElement).getPropertyValue(icingColors[Math.floor(Math.random() * icingColors.length)]);
            layer.style.setProperty('--cake-color', cakeColor.trim());
            layer.style.setProperty('--icing-color', icingColor.trim());
        });
    });
    function closeOpenCards() {
        stack.forEach((card)=>card.classList.remove("open")); // Close all open cards
    }
    function updateStack() {
        stack.forEach((card, index)=>{
            card.classList.remove("active", "inactive");
            if (index === 0) card.classList.add("active");
            else card.classList.add("inactive");
        });
    }
    function updateStackWithAnimation() {
        closeOpenCards(); // Close any open cards
        setTimeout(()=>{
            const activeCard = stack[0];
            const nextCard = stack[1];
            activeCard.classList.add("slide-out");
            nextCard.classList.add("slide-in");
            // Update the stack immediately after applying animation classes
            stack.push(stack.shift()); // Move the top card to the bottom
            updateStack();
            setTimeout(()=>{
                activeCard.classList.remove("slide-out");
                nextCard.classList.remove("slide-in");
            }, 600); // Match the adjusted animation duration
        }, 800); // Delay for closing animation matches opening speed
    }
    function updateStackWithAnimationBack() {
        closeOpenCards(); // Close any open cards
        setTimeout(()=>{
            const activeCard = stack[0];
            const previousCard = stack[stack.length - 1];
            activeCard.classList.add("slide-out");
            previousCard.classList.add("slide-in");
            // Update the stack immediately after applying animation classes
            stack.unshift(stack.pop()); // Move the bottom card to the top
            updateStack();
            setTimeout(()=>{
                activeCard.classList.remove("slide-out");
                previousCard.classList.remove("slide-in");
            }, 600); // Match the adjusted animation duration
        }, 800); // Delay for closing animation matches opening speed
    }
    stack.forEach((card)=>{
        card.addEventListener("click", ()=>{
            if (card.classList.contains("active")) card.classList.toggle("open"); // Toggle the 'open' class
        });
    });
    nextButton.addEventListener("click", updateStackWithAnimation);
    backButton.addEventListener("click", updateStackWithAnimationBack);
    updateStack(); // Initialize the stack
});

