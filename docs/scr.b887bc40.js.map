    else console.error('Main element not found.');
    container.addEventListener('click', function(event) {
        const images = this.querySelectorAll('img');
        // Remove the oldest image if there are already 5 or more
        if (images.length >= 10) images[0].remove();
        // Refill remainingImages if all images have been shown
        if (remainingImages.length === 0) remainingImages = [
            ...imageLinks
        ];
        // Select a random image from remainingImages
        const randomIndex = Math.floor(Math.random() * remainingImages.length);
        const randomImageLink = remainingImages.splice(randomIndex, 1)[0];
        const img = document.createElement('img');
        img.src = randomImageLink;
        this.appendChild(img);
        img.onload = ()=>{
            const divRect = this.getBoundingClientRect();
            const imgWidth = img.offsetWidth;
            const imgHeight = img.offsetHeight;
            // Initial position relative to div
            let left = event.clientX - divRect.left;
            let top = event.clientY - divRect.top;
            // Clamp left/right
            if (left + imgWidth > divRect.width) left = divRect.width - imgWidth;
            if (left < 0) left = 20;
            // Clamp top/bottom
            if (top + imgHeight > divRect.height) top = divRect.height - imgHeight;
            if (top < 0) top = 15;
            img.style.left = `${left}px`;
            img.style.top = `${top}px`;
            img.classList.add('show');
        };
    });
    return container;
