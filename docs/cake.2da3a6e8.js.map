document.addEventListener("DOMContentLoaded", function() {
    // Elements
    const mic = document.getElementById("mic");
    const tap = document.getElementById("tap");
    const tapInstructions = document.getElementById("tapInstructions");
    const micInstructions = document.getElementById("micInstructions");
    const selectModeMessage = document.getElementById("selectModeMessage");
    const instructionsContainer = document.querySelector(".instructions-container");
    const candle = document.querySelector('.cake-candle'); // Updated selector
    micInstructions.style.display = "none";
    tapInstructions.style.display = "none";
    // State flags
    let selectedMode = null;
    let audioContext;
    let micStream;
    let analyser;
    let blowThreshold = 2100;
    let accumulatedBlow = 0; // Accumulated blowing effort
    let isBlowDetectionActive = true; // Flag to control the blow detection loop
    let tapCount = 0;
    const maxTaps = 121; // Number of taps required to extinguish the flame
    let isFlameExtinguished = false; // Flag to ensure extinguishFlame is called only once
    // Add audio element with a song from the internet
    const song = new Audio('https://res.cloudinary.com/drkmgpcad/video/upload/v1743820782/hpbd_itvcwx.mp3'); // Online song URL
    song.loop = false; // Loop the song
    song.preload = "auto"; // Preload the song for buffering
    const waveText = document.querySelector('.wave-text'); // Select the header wave text
    // Function to start the wave animation
    function startWaveAnimation() {
        if (waveText) waveText.classList.add('wave-active'); // Add a class to trigger the animation
    }
    // Function to scroll to the cake section
    function scrollToCake() {
        const cakeContainer = document.querySelector(".container");
        if (cakeContainer) cakeContainer.scrollIntoView({
            behavior: "smooth",
            block: "center"
        });
    }
    // Blow detection
    function startBlowDetection() {
        if (!isBlowDetectionActive) {
            console.log('Blow detection already stopped.'); // Debugging log
            return;
        }
        navigator.mediaDevices.getUserMedia({
            audio: true
        }).then(function(stream) {
            audioContext = new AudioContext();
            micStream = stream;
            const microphone = audioContext.createMediaStreamSource(stream);
            analyser = audioContext.createAnalyser();
            analyser.fftSize = 256;
            microphone.connect(analyser);
            listenForBlow();
        }).catch(function(err) {
            console.error('Error accessing microphone:', err);
            displayMicError(); // Display error message
        });
    }
    // Display microphone error message
    function displayMicError() {
        const instructions = document.getElementById("instructions");
        if (instructions) instructions.innerHTML = `
                <p style="color: red;">Unable to use mic. Please <a href="#" onclick="location.reload()">reload the page</a>.</p>
            `;
    }
    function listenForBlow() {
        const buffer = analyser.frequencyBinCount;
        const data = new Uint8Array(buffer);
        let songStarted = false; // Flag to ensure the song starts only once
        function detectBlow() {
            if (!isBlowDetectionActive) {
                console.log('Blow detection stopped.'); // Debugging log
                return;
            }
            if (selectedMode !== 'mic') {
                console.log('Blow detection skipped, selectedMode is not "mic".'); // Debugging log
                return;
            }
            analyser.getByteFrequencyData(data);
            const averageAmplitude = data.reduce((sum, value)=>sum + value, 0) / buffer;
            console.log('Raw frequency data:', data); // Debugging log for raw data
            console.log('Detecting blow, average amplitude:', averageAmplitude); // Log detection
            if (averageAmplitude > 150) {
                if (!songStarted) {
                    song.play().then(startWaveAnimation); // Start playing the song and wave animation when a significant blow is detected
                    songStarted = true; // Ensure the song starts only once
                }
                accumulatedBlow += averageAmplitude; // Accumulate the blowing effort
                const progress = Math.min(accumulatedBlow / blowThreshold, 1); // Normalize progress
                console.log('Accumulated blow:', accumulatedBlow, 'Progress:', progress); // Debugging log
                dimFlame(progress);
                if (accumulatedBlow >= blowThreshold) {
                    extinguishFlame();
                    isBlowDetectionActive = false; // Stop the blow detection loop
                    console.log('Blow detection and startBlowDetection stopped.'); // Debugging log
                }
            } else console.log('No significant blow detected.'); // Debugging log
            if (isBlowDetectionActive) requestAnimationFrame(detectBlow);
        }
        detectBlow();
    }
    // Extinguish flame
    function extinguishFlame() {
        if (isFlameExtinguished) return; // Prevent multiple executions
        isFlameExtinguished = true;
        if (candle) candle.classList.add('extinguished');
        triggerBalloonAnimation(); // Trigger balloon animation
        // Stop the current song if it's playing
        if (!song.paused) {
            song.pause();
            song.currentTime = 0;
        }
        // Play the new song after a 300ms delay
        setTimeout(()=>{
            const endSong = new Audio('https://res.cloudinary.com/drkmgpcad/video/upload/v1743825752/end_o5mep7.mp3');
            endSong.play();
        }, 300);
    }
    function triggerBalloonAnimation() {
        const balloonContainer = document.getElementById("balloon-container");
        function random(num) {
            return Math.floor(Math.random() * num);
        }
        function getRandomStyles() {
            var r = random(255);
            var g = random(255);
            var b = random(255);
            var mt = random(200);
            var ml = random(50);
            var dur = random(5) + 5;
            return `
            background-color: rgba(${r},${g},${b},0.7);
            color: rgba(${r},${g},${b},0.7); 
            box-shadow: inset -7px -3px 10px rgba(${r - 10},${g - 10},${b - 10},0.7);
            margin: ${mt}px 0 0 ${ml}px;
            animation: float ${dur}s ease-in infinite
            `;
        }
        function createBalloons(num) {
            for(var i = num; i > 0; i--){
                var balloon = document.createElement("div");
                balloon.className = "balloon";
                balloon.style.cssText = getRandomStyles();
                balloonContainer.append(balloon);
            }
        }
        function removeBalloons() {
            balloonContainer.style.opacity = 0;
            setTimeout(()=>{
                balloonContainer.remove();
            }, 500);
        }
        createBalloons(30);
        setTimeout(()=>{
            removeBalloons();
        }, 10000); // Remove balloons after 10 seconds
    }
    // Dim the flame
    function dimFlame(progress) {
        console.log('dimFlame called with progress:', progress); // Debugging log
        if (candle) {
            const opacity = Math.max(1 - progress, 0); // Gradually reduce opacity
            console.log('Dimming flame, progress:', progress, 'calculated opacity:', opacity); // Debugging log
            candle.style.setProperty('--flame-opacity', opacity); // Use CSS variable for smooth transition
            // Check if opacity is 0 and extinguish the flame
            if (opacity === 0) extinguishFlame();
        } else console.log('Candle element not found.'); // Debugging log
    }
    // Mic mode
    mic.addEventListener("click", function() {
        selectedMode = 'mic';
        if (micInstructions) micInstructions.style.display = "block"; // Show mic instructions
        if (tapInstructions) tapInstructions.style.display = "none"; // Hide tap instructions
        if (selectModeMessage) selectModeMessage.style.display = "none"; // Hide select mode message
        if (instructionsContainer) instructionsContainer.style.display = "none"; // Hide instructions-container
        scrollToCake(); // Snap to the cake section
        startBlowDetection();
        song.play().then(startWaveAnimation); // Start the song and wave animation
    });
    // Tap mode
    tap.addEventListener("click", function() {
        selectedMode = 'tap';
        if (micInstructions) micInstructions.style.display = "none"; // Hide mic instructions
        if (tapInstructions) tapInstructions.style.display = "block"; // Show tap instructions
        if (selectModeMessage) selectModeMessage.style.display = "none"; // Hide select mode message
        if (instructionsContainer) instructionsContainer.style.display = "none"; // Hide instructions-container
        scrollToCake(); // Snap to the cake section
        song.play().then(startWaveAnimation); // Start the song and wave animation
    });
    // Tap detection
    if (candle) candle.addEventListener('touchstart', function() {
        if (selectedMode !== 'tap') {
            if (selectModeMessage) selectModeMessage.style.display = "block"; // Show select mode message
            return;
        }
        tapCount++;
        const progress = Math.min(tapCount / maxTaps, 1); // Normalize progress
        dimFlame(progress);
        if (tapCount >= maxTaps) extinguishFlame();
    }, {
        passive: true
    }); // Mark event listener as passive
    else console.error('Candle element not found.'); // Log error if candle is null
    // Cleanup mic on exit
    window.addEventListener("beforeunload", function() {
        if (audioContext) {
            audioContext.close();
            micStream.getTracks().forEach((track)=>track.stop());
        }
    });
});

